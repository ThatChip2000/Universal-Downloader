# Entorno virtual y caché de Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Artefactos de compilación de PyInstaller (se excluyen .exe/.zip excepto qjs.exe,
# que es el motor JavaScript portátil QuickJS-ng de ~1.8 MB usado como respaldo EJS para YouTube)
build/
dist/
*.exe
!qjs.exe
*.zip

# Carpetas locales de descargas y pruebas
Descargas/
EVERYONE IS HERE/

# Atajos locales, notas internas y archivos exclusivos del ZIP portable
*.bat
LEEME_ANTES_DE_ABRIR.txt
CONTEXTO_PROYECTO.md
auditoria.md
